<Window x:Class="GameLauncher.CloudSavesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sauvegardes cloud" Height="480" Width="520"
        Background="#FF1a1a2e" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontFamily="Optimus"
                       FontSize="20" Foreground="White"/>
            <TextBlock x:Name="QuotaText" FontFamily="Optimus"
                       FontSize="12" Foreground="#AAFFFFFF" Margin="0,4,0,0"/>
        </StackPanel>

        <Button x:Name="UploadButton" Grid.Row="1" Content="Sauvegarder maintenant sur le cloud" Click="UploadButton_Click"
                Height="34" FontFamily="Optimus" FontSize="13"
                Background="#545ba8" Foreground="White" BorderBrush="Transparent" Margin="0,0,0,10"/>

        <ListBox x:Name="SavesList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#22FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding DisplayLabel}" FontFamily="Optimus"
                                           FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SubText}" FontFamily="Optimus"
                                           FontSize="11" Foreground="#88FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Restaurer" Tag="{Binding Id}" Click="RestoreButton_Click"
                                    Height="28" Padding="10,0" Margin="0,0,6,0"
                                    FontFamily="Optimus" FontSize="11"
                                    Background="#3a7a3a" Foreground="White" BorderBrush="Transparent"/>
                            <Button Grid.Column="2" Content="Supprimer" Tag="{Binding Id}" Click="DeleteButton_Click"
                                    Height="28" Padding="10,0"
                                    FontFamily="Optimus" FontSize="11"
                                    Background="#7a3a3a" Foreground="White" BorderBrush="Transparent"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" FontFamily="Optimus"
                       FontSize="12" TextWrapping="Wrap" Foreground="White" Margin="0,0,0,8"/>
            <Button Content="Fermer" Click="CloseButton_Click" Height="30" Width="100" HorizontalAlignment="Right"
                    FontFamily="Optimus" FontSize="12"
                    Background="#333a6e" Foreground="White" BorderBrush="Transparent"/>
        </StackPanel>
    </Grid>
</Window>
